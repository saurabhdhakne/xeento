# Copy to .env.local (git ignores it) and fill in. All are read at build time.

# Google Drive file storage in Sync mode. See docs/setup/google-drive.md.
# Client ID only: never put the client secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Serve the app from a sub-path, e.g. /xeento for GitHub Pages. Default: empty.
# NEXT_PUBLIC_BASE_PATH=

# Where link previews are fetched. Default: <basePath>/api/link-preview on
# `npm run build`, empty on `npm run build:static`. Empty turns previews off.
# NEXT_PUBLIC_LINK_PREVIEW_URL=

# Development only: 1 points Sync mode at local Firebase emulators.
# Never set it for a real build.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
